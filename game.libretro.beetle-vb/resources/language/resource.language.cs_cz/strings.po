msgctxt "Addon Summary"
msgid "Nintendo - Virtual Boy (Beetle VB)"
msgstr "Nintendo - Virtual Boy (Beetle VB)"

msgctxt "Addon Description"
msgid "Beetle VB emulates the Nintendo Virtual Boy, a tabletop video game console capable of displaying stereoscopic 3D graphics."
msgstr "Beetle VB emuluje Nintendo Virtual Boy, stolní herní konzoli schopnou zobrazovat stereoskopickou 3D grafiku."

msgctxt "#30002"
msgid "Anaglyph preset"
msgstr "Předvolba anaglyfu"

msgctxt "#30003"
msgid "Palette"
msgstr "Paleta"

msgctxt "#30004"
msgid "Right analog to digital"
msgstr "Pravý analog na digitální vstup"

msgctxt "#30005"
msgid "CPU emulation  (Restart)"
msgstr "Emulace CPU  (vyžaduje restart)"

msgctxt "#30006"
msgid "Side-by-side separation"
msgstr "Oddělení zobrazení vedle sebe"

msgctxt "#30007"
msgid "3D mode (requires restart)"
msgstr "Režim 3D (vyžaduje restart)"

msgctxt "#30008"
msgid "Allow Opposite Directions"
msgstr "Povolit opačné směry"

msgctxt "#30009"
msgid "Select the 3D mode. Anaglyph - used in conjunction with classic dual-lens-color glasses. Cyberscope - intended for use with the CyberScope 3D device. sidebyside - the left-eye image is displayed on the left, and the right-eye image is displayed on the right. vli - Vertical lines alternate between left and right view. hli - Horizontal lines alternate between left and right view."
msgstr "Vybrat režim 3D. Anaglyph – používá se spolu s klasickými brýlemi s barevnými čočkami. Cyberscope – určen pro 3D zařízení CyberScope. sidebyside – obraz levého oka se zobrazuje vlevo a obraz pravého oka vpravo. vli – svislé čáry se střídají mezi levým a pravým pohledem. hli – vodorovné čáry se střídají mezi levým a pravým pohledem."

msgctxt "#30010"
msgid "Anaglyph preset colors."
msgstr "Barvy předvolby anaglyfu."

msgctxt "#30011"
msgid "Number of pixels to separate left and right views in side-by-side 3D mode."
msgstr "Počet pixelů oddělujících levý a pravý pohled v režimu 3D vedle sebe."

msgctxt "#30012"
msgid "Allow pressing up and down or left and right directions at the same time. This may cause glitches."
msgstr "Povolit současné stisknutí směrů nahoru a dolů nebo doleva a doprava. Může způsobit grafické chyby."

msgctxt "#30013"
msgid "Choose between faster and accurate (slower) emulation."
msgstr "Volba mezi rychlejší a přesnější (pomalejší) emulací."

#~ msgctxt "#30001"
#~ msgid "3D mode"
#~ msgstr "Režim 3D"
